  "replica_comparison": {
    "two_replicas": {
      "throughput_rps": 3.6417994518620245,
      "p50_ms": 10000.0,
      "p95_ms": 43000.0,
      "p99_ms": 69000.0,
      "failures": 0,
      "from_scenario": "sustained_r2"
    },
    "five_replicas": {
      "throughput_rps": 3.9274484282551034,
      "p50_ms": 10000.0,
      "p95_ms": 38000.0,
      "p99_ms": 67000.0,
      "failures": 0,
      "from_scenario": "sustained_r5"
    },
    "throughput_gain_ratio": 1.078,
    "load_at_test_users": 50,
    "interpretation": "2.5x the replicas (2 -> 5) at 50 closed-loop users gave a 1.078x request rate. Both runs had zero failures. In a closed loop the offered rate falls as latency rises, so this is an observation at one concurrency and think-time policy, not a capacity ceiling, and it does not identify which resource limited throughput. Whether r=5 survives the 200-user spike that broke r=2 was not measured."
  },
  "saturation_cliff": {
    "scenario": "spike_r2",
    "users_at_peak": 200,
    "duration_s": 120,
    "replicas": 2,
    "requests": 4359,
    "failures": 3724,
    "failure_rate": 0.8543,
    "primary_error": "RemoteDisconnected",
    "errors_by_type": {
      "RemoteDisconnected": 3633,
      "ConnectionResetError": 91
    },
    "p50_note": "Locust percentiles mix failed and successful requests; p50=2-3 ms here is the latency of immediately failed requests, not service."
  },
  "event_loop_contention": {
    "comparison": "rampup_r2 (peak 100 users) vs sustained_r2 (50 users), both r=2",
    "high_load_health_p95_ms": 7200.0,
    "medium_load_health_p95_ms": 14.0,
    "ratio": 514.3,
    "explanation": "Same code and replica count; the user count differs (and rampup is not steady state). /health has no external dependencies, so a slow /health shows request-serving pressure. /health is a sync endpoint sharing the threadpool with /query and /agent, which makes threadpool queueing a candidate mechanism; this bundle records no occupancy data to confirm it."
  },
  "unverified_operator_notes": [
    {
      "note": "Both pods were SIGKILLed by the kubelet liveness probe at t~110s of spike_r2 and restarted without operator intervention.",
      "status": "unverified: no kubectl events or termination reasons were saved. k_top_phase3.log shows metrics unavailable for one pod at t=120s and both pods at about half their prior memory at t=135s, which fits a restart but does not say why (memory was 1714-1819Mi of a 2Gi limit)."
